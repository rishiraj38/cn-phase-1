# ---------------------------------------------------------------------------
# team.env  -  the ONE file every machine reads.
# Fill this in once (same values on every Mac), commit it, pull it everywhere.
# ---------------------------------------------------------------------------

# Team identity
TEAM_NAME="team"            # shown in pages / logs
TEAM_ID="team"              # lowercase, no spaces -> domain becomes team.test
DOMAIN="${TEAM_ID}.test"    # reserved .test TLD (never .local - it clashes with mDNS)

# Private LAN addresses - our team is TWO Macs, so the four PDF roles are combined
# (PDF section 3: "Teams of 2-3 may combine machine roles"):
#   SERVER Mac (Rishi)    = Mac 1 DNS  + Mac 2 Edge + Mac 3 Backend A
#   CLIENT Mac (partner)  = Mac 4 Backend B + test client (browser, curl, Wireshark)
# Find each IP with:  ipconfig getifaddr en0
SERVER_IP="192.168.1.10"     # <- Rishi's Mac
CLIENT_IP="192.168.1.20"     # <- partner's Mac
SERVER_MAC="Rishi's Mac (server)"
CLIENT_MAC="partner's Mac (client)"

MAC1_IP="${SERVER_IP}"       # DNS server (dnsmasq)
MAC2_IP="${SERVER_IP}"       # Edge: nginx reverse proxy + load balancer + TLS
MAC3_IP="${SERVER_IP}"       # Backend A  :3001
MAC4_IP="${CLIENT_IP}"       # Backend B  :3002 + test client
DNS_MAC="${SERVER_MAC}"; EDGE_MAC="${SERVER_MAC}"; A_MAC="${SERVER_MAC}"; B_MAC="${CLIENT_MAC}"

# Ports
BACKEND_A_PORT=3001
BACKEND_B_PORT=3002
HTTPS_PORT=443              # use 8443 if your Mac refuses to bind 443
HTTP_PORT=80                # use 8080 if your Mac refuses to bind 80

# DNS
UPSTREAM_DNS="8.8.8.8"      # where Mac 1 forwards everything that is NOT *.DOMAIN
DNS_TTL=60                  # TTL (seconds) on our records - visible in dig output

# Used only by the "DNS record points to a wrong IP" failure demo
WRONG_IP="${CLIENT_IP}"     # a real machine with NO dns server and NOTHING on :443
