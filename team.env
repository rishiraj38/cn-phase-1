# ---------------------------------------------------------------------------
# team.env  -  the ONE file every machine reads.
# Fill this in once (same values on every Mac), commit it, pull it everywhere.
# ---------------------------------------------------------------------------

# Team identity
TEAM_NAME="Team X"          # shown in pages / logs
TEAM_ID="teamx"             # lowercase, no spaces -> domain becomes teamx.test
DOMAIN="${TEAM_ID}.test"    # reserved .test TLD (never .local - it clashes with mDNS)

# Private LAN addresses (run scripts/inventory.sh on each Mac to find them)
# For a 2 or 3 Mac team just repeat an IP - e.g. MAC4_IP=$MAC3_IP puts both
# backends on the same Mac (they still use different ports, so it works).
MAC1_IP="192.168.1.11"      # DNS server (dnsmasq) + test client
MAC2_IP="192.168.1.12"      # Edge: nginx reverse proxy + load balancer + TLS
MAC3_IP="192.168.1.13"      # Backend A
MAC4_IP="192.168.1.14"      # Backend B + test client

# Ports
BACKEND_A_PORT=3001
BACKEND_B_PORT=3002
HTTPS_PORT=443              # use 8443 if your Mac refuses to bind 443
HTTP_PORT=80                # use 8080 if your Mac refuses to bind 80

# DNS
UPSTREAM_DNS="1.1.1.1"      # where Mac 1 forwards everything that is NOT *.DOMAIN
DNS_TTL=60                  # TTL (seconds) on our records - visible in dig output

# Used only by the "DNS record points to a wrong IP" failure demo
WRONG_IP="${MAC3_IP}"       # a real machine that is NOT running nginx
