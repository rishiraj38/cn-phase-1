# team.env  -  the ONE file every machine reads (same on both Macs)

# Team identity
TEAM_NAME="team"
TEAM_ID="team"
DOMAIN="${TEAM_ID}.test"

# 2-Mac team: roles combined (PDF: "Teams of 2-3 may combine machine roles")
#   SERVER Mac (Rishi)   = DNS + Edge + Backend A
#   CLIENT Mac (Kaustubh) = Backend B + test client
SERVER_IP="10.7.16.15"      # <- Rishi's Mac
CLIENT_IP="10.7.3.40"       # <- Kaustubh's Mac
SERVER_MAC="Rishi's Mac (server)"
CLIENT_MAC="Kaustubh's Mac (client)"

MAC1_IP="${SERVER_IP}"      # DNS server (dnsmasq)
MAC2_IP="${SERVER_IP}"      # Edge: nginx + load balancer + TLS
MAC3_IP="${SERVER_IP}"      # Backend A  :3001
MAC4_IP="${CLIENT_IP}"      # Backend B  :3002 + test client
DNS_MAC="${SERVER_MAC}"; EDGE_MAC="${SERVER_MAC}"; A_MAC="${SERVER_MAC}"; B_MAC="${CLIENT_MAC}"

# Ports
BACKEND_A_PORT=3001
BACKEND_B_PORT=3002
HTTPS_PORT=443
HTTP_PORT=80

# DNS
UPSTREAM_DNS="8.8.8.8"
DNS_TTL=60

# Used only by the "DNS record points to a wrong IP" failure demo
WRONG_IP="${CLIENT_IP}"